---
import BaseLayout from "../layouts/BaseLayout.astro";
const allTripReports = Object.values(import.meta.glob("./tripReports/*.md", { eager: true }));
const allPoetry = Object.values(import.meta.glob("./poetry/*.md", { eager: true }));
const allBikepacking = Object.values(import.meta.glob("./bikepacking/*.md", { eager: true }));
const combinedPosts = [...allPoetry, ...allTripReports, ...allBikepacking];
const uniqueTags = [
    ...new Set(combinedPosts.map((post) => post.frontmatter.tags).flat()),
];
---

<BaseLayout>
    <div class="container py-2" style="height:50rem">
        <h1>Sort by tag</h1>
        <div class="tags">
            {
                uniqueTags.map((tag) => (
                    <p class="tag">
                        <a href={`/tags/${tag}`}>{tag}</a>
                    </p>
                ))
            }
        </div>
    </div>
</BaseLayout>
<style>
    a {
        color: #00539f;
    }
    .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
    .tag {
        margin: 0.25em;
        border: dotted 1px #a1a1a1;
        border-radius: 0.5em;
        padding: 0.5em 1em;
        font-size: 1.15em;
        background-color: #f8fcfd;
    }
</style>
